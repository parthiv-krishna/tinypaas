# An app generated by `tinypaas new`, built exactly as its own flake would
# (same vendorHash), so template drift breaks `nix flake check`.
{ pkgs, tinypaas }:
let
  templateFlake = builtins.readFile ../internal/scaffold/template/flake.nix;
  vendorHash = builtins.head (builtins.match ''.*vendorHash = "([^"]+)".*'' templateFlake);
  src = pkgs.runCommand "template-app-src" { } ''
    ${pkgs.lib.getExe tinypaas} new -dir $out -description "generated by tinypaas new" template-app
  '';
in
pkgs.buildGoModule {
  pname = "template-app";
  version = "0";
  inherit src vendorHash;
  env.CGO_ENABLED = 0;
  passthru.manifest = "${src}/app.json";
}
